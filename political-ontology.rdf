        <sch:madeBy rdf:resource="http://ugm.ac.id/ontology/political-ontology/data#Person_00001"/>
        <sch:textStatement xml:lang="id">Hari ini di Semarang, Senin 1 Januari 2024, menyatakan dukungan sepenuhnya kepada Bapak Ganjar Pranowo dan Bapak Mahfud MD sebagai calon presiden dan calon wakil presiden RI 2024-2029,</sch:textStatement>
    </owl:NamedIndividual>
