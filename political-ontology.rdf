    <owl:NamedIndividual rdf:about="http://ugm.ac.id/ontology/political-ontology/data#Person_00001">
        <rdf:type rdf:resource="http://ugm.ac.id/ontology/political-ontology/sch#Person"/>
        <sch:personName xml:lang="id">Lasiman</sch:personName>
    </owl:NamedIndividual>
    


